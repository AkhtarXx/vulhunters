# Copy to .env only when overriding defaults. Subscription credentials are
# managed by the installed Codex, Claude Code, or Hermes CLI.
LLM_PROVIDER=codex
LLM_TIMEOUT=300
VULNHUNTERS_SCOPE_MODE=default

# Optional local security-tool paths (otherwise discovered on PATH).
# SLITHER_PATH=C:\tools\slither.exe
# FORGE_PATH=C:\tools\forge.exe
# SOLC_PATH=C:\tools\solc.exe

# Optional Hermes installation paths for direct OAuth transport.
# HERMES_SOURCE=C:\path\to\hermes-agent
# HERMES_PYTHON=C:\path\to\hermes-agent\venv\Scripts\python.exe
