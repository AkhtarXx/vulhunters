# =============================================================================
# GEMINI AI CONFIGURATION
# =============================================================================

# Gemini API Key - Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model configurations (optional - Deep Research used for all tasks)
GEMINI_MODEL=deep-research-pro-preview-12-2025
GEMINI_PRO_MODEL=deep-research-pro-preview-12-2025
DEEP_RESEARCH_AGENT=deep-research-pro-preview-12-2025

# =============================================================================
# SECURITY TOOLS (Optional - for local tool execution)
# =============================================================================

# Slither Configuration
SLITHER_PATH=/usr/local/bin/slither

# Mythril Configuration
MYTHRIL_PATH=/usr/local/bin/myth
MYTHRIL_TIMEOUT=300

# Echidna Configuration
ECHIDNA_PATH=/usr/local/bin/echidna

# Foundry Configuration
FOUNDRY_PATH=/home/grey/.foundry/bin

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================

# Local MCP server ports
SLITHER_MCP_PORT=8001
MYTHRIL_MCP_PORT=8002
ECHIDNA_MCP_PORT=8003

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Context Cache TTL (seconds)
CACHE_TTL=3600

# File Search Store prefix
FILE_SEARCH_STORE_PREFIX=vuln_detector

# =============================================================================
# BLOCKCHAIN CONFIGURATION (for mainnet fork testing)
# =============================================================================

# Ethereum RPC (for forked mainnet testing)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_key
# Or use local node
# ETH_RPC_URL=http://localhost:8545

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
